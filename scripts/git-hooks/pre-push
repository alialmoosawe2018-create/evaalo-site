#!/bin/sh
# Refuse to push `master` while an interview is live on the site.
#
# The owner's rule since launch (2026-09-23): no deploy while an interview is
# running — and every push to `master` rebuilds and publishes the frontend on
# Cloudflare Pages. Other branches push freely.
#
# Installed by `npm run hooks:install` (copies this file to .git/hooks/pre-push).
# Do not bypass it with --no-verify: wait for the interview to end.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
ROOT="$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master)
      node "$ROOT/scripts/check-live-interviews.mjs" || exit 1
      ;;
  esac
done
exit 0
