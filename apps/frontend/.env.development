VITE_API_URL=http://localhost:5000
VITE_ENABLE_LEGACY_WS_FALLBACK=false
# Default in code is high (clearer while avatar talks). Use medium on very slow links.
VITE_AVATAR_VIDEO_QUALITY=high
VITE_AVATAR_VIDEO_UNSUB_DEBOUNCE_MS=2600
# إن بقي غطاء التحميل بدون فيديو أفاتار — إخفاء احتياطي بعد المهلة (افتراضي الكود 45000؛ يبدأ من ظهور الغطاء مباشرة)
# VITE_AVATAR_LOADING_MAX_WAIT_MS=45000
# عد تنازلي بصري على غطاء Start (افتراضي الكود 30→0). لا يؤثر على الوكيل. 0 = سبينر بدون عدّ
VITE_PREPARATION_COUNTDOWN_SECONDS=0
# تأخير بعد انتهاء كلام الوكيل قبل تفعيل الميك؛ مرتفع جداً = فقدان أول كلمات في Speechmatics. ارفع تدريجياً (280–450) إن زاد صدى في الميك.
VITE_AVATAR_MIC_UNMUTE_DELAY_MS=200
# مهلة قبل تحويل speaking -> listening عند صمت الأفاتار. رفعها يمنع التبديل أثناء توقفات قصيرة داخل نفس الرد.
VITE_AGENT_STATE_AUDIO_IDLE_MS=180
VITE_AVATAR_MIC_MUTE_WHILE_THINKING=true
