# Cloudflare Pages — response headers.
# Syntax: a path pattern on its own line, then "Header: value" lines indented.
# CSP is deliberately absent for now — it is added later as Report-Only once
# production is stable (Clerk / Stripe / LiveKit all need explicit allowances).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # camera/microphone are required by the voice & video interview flows
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Hashed Vite assets — allow revalidation so a deploy race cannot stick HTML as CSS.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
