# Cloudflare Pages — response headers.
# Syntax: a path pattern on its own line, then "Header: value" lines indented.
# CSP is deliberately absent for now — it is added later as Report-Only once
# production is stable (Clerk / Stripe / LiveKit all need explicit allowances).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # camera/microphone are required by the voice & video interview flows
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Vite emits content-hashed filenames here, so these are safe to cache for a year.
#
# Deliberately without `immutable`: a request for an asset that is missing during a
# deploy is answered with index.html at status 200, and this rule stamps that HTML
# with a year of caching under the asset's URL. `immutable` additionally forbids
# revalidating even on a forced reload, which turns a few seconds of bad timing into
# a permanently broken page for every client behind that cache. Without it, a
# forced reload heals it, and normal navigation still never refetches, because
# max-age alone keeps the asset fresh and Pages answers revalidation with a 304.
/assets/*
  Cache-Control: public, max-age=31536000
