# ============================================
# إعداد الملف: انسخ هذا الملف إلى .env وعدّل القيم
#   Windows: copy env.example .env
#   Mac/Linux: cp env.example .env
# ============================================

# ============================================
# مطلوب للمقابلة الصوتية (Voice Interview)
# بدون هذه المفاتيح ستظهر تحذيرات ولن يعمل LLM/TTS
# ============================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============================================
# Server Configuration
# ============================================
PORT=5000
# الاستماع على جميع واجهات الشبكة (افتراضي). للتقييد على الجهاز فقط استخدم: 127.0.0.1
LISTEN_HOST=0.0.0.0
NODE_ENV=development

# ============================================
# MongoDB — الرابط الكامل من المتغير MONGODB_URI فقط (Atlas أو محلي)
# مثال (بدل USER و PASS و hosts): mongodb://USER:PASS@h0:27017,h1:27017,h2:27017/mydb?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority
# مهلة أطول لا تصلح الحجب؛ تساعد أحياناً على شبكات بطيئة فقط:
# MONGODB_CONNECT_TIMEOUT_MS=35000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# ============================================
# MONGODB_URI=

# ============================================
# Frontend URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# n8n — مساران منفصلان (Production URL لكل workflow)
# ============================================
# n8n يرسل نتائج التقييم إلى PUBLIC_API_URL/webhook/stage1|2|3 (مثال إنتاج: https://api.evaalo.com/webhook/stage1)
# بيانات الاستمارة / المرشح + المعايير
N8N_WEBHOOK_URL=https://n8n.evaalo.com/webhook/cc4f6e33-27c8-444e-bd55-e21963bb7e56
# ترانسكريبت الصوت + التقييم (workflow منفصل). إن تركت فارغاً يُرسل الصوت إلى N8N_WEBHOOK_URL (للتطوير فقط).
N8N_VOICE_TRANSCRIPT_WEBHOOK_URL=https://n8n.evaalo.com/webhook/c7ab59d7-d23c-4f3a-bb38-5d6c9b1ce182
# المقابلة الصوتية العامة (رابط مشارَك، mode=public): ترانسكريبت + Job criteria (workflow منفصل).
# إن تُرك فارغاً يرجع إلى N8N_VOICE_TRANSCRIPT_WEBHOOK_URL ثم N8N_WEBHOOK_URL. نتائج التقييم تعود إلى /webhook/n8n/stage2.
N8N_PUBLIC_SCREENING_WEBHOOK_URL=
# ترانسكريبت مقابلة الفيديو (workflow منفصل). إن تركته فارغاً يُرسل الفيديو إلى N8N_WEBHOOK_URL.
N8N_VIDEO_TRANSCRIPT_WEBHOOK_URL=https://n8n.evaalo.com/webhook/2414e184-611d-4691-96fe-9b496a270c62
# مقابلة الفيديو العامة (رابط مشارَك، mode=public): ترانسكريبت + Job criteria (workflow منفصل).
# إن تُرك فارغاً يرجع إلى N8N_VIDEO_TRANSCRIPT_WEBHOOK_URL ثم N8N_WEBHOOK_URL. نتائج التقييم تعود إلى /webhook/n8n/stage3.
N8N_PUBLIC_VIDEO_SCREENING_WEBHOOK_URL=
# صفحة لوحة التحكم AI Head Hunter — POST JSON من الباكند إلى n8n (searchId + callbackUrl + token)
N8N_HEADHUNTER_WEBHOOK_URL=
# استقبال نتائج Head Hunter من n8n (→ /webhook/n8n/head-hunter?searchId=…&token=…). إن ضُبط، أرسل X-Head-Hunter-Secret
N8N_HEADHUNTER_INBOUND_SECRET=
# Stage 1/2/3 — أمان callbacks بين n8n والباكند (HMAC + inbound secret). لا تضع قيماً حقيقية هنا.
# سر استقبال n8n على /webhook/n8n/stage1|2|3 (رأس X-n8n-stage-secret)
N8N_STAGE_INBOUND_SECRET=
# سر توقيع HMAC لـ callbackUrl المُرسل إلى n8n
STAGE_CALLBACK_SIGNING_SECRET=
# قائمة origins مسموحة لـ PUBLIC_API_URL عند mint callbackUrl (فاصلة بين القيم)
STAGE_CALLBACK_ALLOWLIST=
# optional = legacy outbound عند غياب الأسرار؛ required = رفض الإرسال بدون bundle موقّع
STAGE_CALLBACK_SECURITY_MODE=
# Stage 2 voice evaluation gate: observe = log incomplete contract, allow persistence; enforce = HTTP 400 STAGE2_INCOMPLETE_EVALUATION
STAGE2_EVALUATION_GATE_MODE=observe
# Stage 3 video evaluation gate: observe = log incomplete contract, allow persistence; enforce = HTTP 400 STAGE3_INCOMPLETE_EVALUATION
STAGE3_EVALUATION_GATE_MODE=observe
# سماحية اختلاف الساعة بالثواني عند التحقق من issuedAt/expiresAt (افتراضي 300)
STAGE_CALLBACK_CLOCK_SKEW_SEC=
# قائمة origins مسموحة لـ PUBLIC_API_URL عند mint callbackUrl Head Hunter (فاصلة بين القيم، مطلوبة).
# أمثلة محلية: http://localhost:5000,http://127.0.0.1:5000,http://100.x.x.x:5000
HEAD_HUNTER_CALLBACK_ALLOWLIST=
# AI CV Comparison — upload PDFs + job criteria; backend POST multipart to n8n.
# If the webhook URL, inbound secret, PUBLIC_API_URL, or callback allowlist is missing or invalid,
# CV comparison returns 503 and does not call n8n.
# Example allowlist (comment only): http://localhost:5000,http://127.0.0.1:5000
N8N_CV_COMPARISON_WEBHOOK_URL=
N8N_CV_COMPARISON_INBOUND_SECRET=
CV_COMPARISON_CALLBACK_ALLOWLIST=
# مقارنة أفضل المرشحين (المرحلة 1) — POST JSON من الباكند إلى n8n (مستقل عن باقي الـ webhooks)
N8N_SCREENING_AI_COMPARE_WEBHOOK_URL=https://n8n.evaalo.com/webhook/9391209e-26c0-48f9-858e-8136e62ab787
# مقارنة أفضل المرشحين (المرحلة 2 — Voice) — POST JSON من الباكند إلى n8n
N8N_VOICE_AI_COMPARE_WEBHOOK_URL=https://n8n.evaalo.com/webhook/a7b9b932-43e6-4666-b107-9bc664542392
# مقارنة أفضل المرشحين (المرحلة 3 — Video) — POST JSON من الباكند إلى n8n
N8N_VIDEO_AI_COMPARE_WEBHOOK_URL=https://n8n.evaalo.com/webhook/c0de9126-4c40-484f-afa3-ba8708b67965
# استقبال نتيجة المقارنة من n8n (→ /webhook/n8n/{screening|voice|video}-ai-compare). إن ضُبط، أرسل X-AI-Compare-Secret (يُستخدم لكل المراحل)
# N8N_SCREENING_AI_COMPARE_INBOUND_SECRET=
# عند 404 على الرابط أعلاه: إعادة إرسال الترانسكريبت إلى N8N_WEBHOOK_URL (مؤقت — يخلط مع workflow الاستمارة)
# N8N_VOICE_WEBHOOK_404_FALLBACK=true

# ============================================
# Campaign Compare v2 (secure pool + HMAC callback) — Hybrid adapter on /ai-compare-top
# ============================================
# false = legacy ai-compare-top (default until local E2E). true = adapter delegates to Campaign Compare v2.
CAMPAIGN_COMPARE_V2_ENABLED=false
# N8N_CAMPAIGN_COMPARE_INBOUND_SECRET must match the same value configured independently in n8n runtime env.
N8N_CAMPAIGN_COMPARE_INBOUND_SECRET=
CAMPAIGN_COMPARE_CALLBACK_SIGNING_SECRET=
CAMPAIGN_COMPARE_CALLBACK_ALLOWLIST=
CAMPAIGN_COMPARE_CALLBACK_SECURITY_MODE=required
CAMPAIGN_COMPARE_CALLBACK_CLOCK_SKEW_SEC=
CAMPAIGN_COMPARE_CALLBACK_TOKEN_TTL_SEC=
N8N_CAMPAIGN_COMPARE_STAGE1_WEBHOOK_URL=
N8N_CAMPAIGN_COMPARE_STAGE2_WEBHOOK_URL=
N8N_CAMPAIGN_COMPARE_STAGE3_WEBHOOK_URL=
CAMPAIGN_COMPARE_ALLOW_ORG_IDS=org_default

# ============================================
# Integrations (LinkedIn + WhatsApp) — ربط حسابات المؤسسة
# ============================================
# مفاتيح تشفير أسرار التكاملات (AES-256-GCM) مع دعم التدوير (key rotation).
# الصيغة: version:base64(32-byte key) مفصولة بفواصل. الأول = الحالي (للتشفير)، البقية للقراءة.
# توليد مفتاح: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENC_KEYS=
# علم أتمتة LinkedIn (بحث/رسائل). معطّل افتراضياً لأسباب ToS/مخاطرة.
LINKEDIN_AUTOMATION_ENABLED=false
# مزوّد LinkedIn الافتراضي (وسم فقط؛ الربط يتم عبر Unipile Hosted Auth).
LINKEDIN_PROVIDER=unipile
# Unipile (Hosted Auth) — مفتاح المنصّة (واحد، لا يراه المستخدم). DSN من لوحة Unipile.
# المستخدم يضغط Connect → نولّد رابط تسجيل دخول مُستضاف → Unipile يرسل account_id إلى notify.
UNIPILE_DSN=
UNIPILE_API_KEY=
# سرّ يحمي مسار الإشعار /api/integrations/unipile/notify (يُضاف كـ ?secret=).
UNIPILE_NOTIFY_SECRET=
# العنوان العام للباكند — يُستخدم لبناء notify_url لـ Unipile (يجب أن يكون قابلاً للوصول من الإنترنت).
PUBLIC_API_URL=http://localhost:5000
# رابط n8n لإرسال رسائل LinkedIn (بديل عند عدم تهيئة Unipile للإرسال).
N8N_LINKEDIN_MESSAGE_WEBHOOK_URL=
# WhatsApp Business Cloud API — إصدار Graph (كردنشل كل مؤسسة تُخزَّن عبر الربط).
WHATSAPP_GRAPH_VERSION=v21.0

# ============================================
# Cloudflare R2 (تخزين تسجيلات المقابلات الصوتية)
# ============================================
# عند ضبط هذه المفاتيح كاملةً يُفعَّل تسجيل المحادثة الصوتية الكاملة (المرشح + الوكيل) ورفعها إلى R2.
# الملفات تُخزَّن كملفات خاصة (Private)؛ يُولَّد رابط موقّت عند الطلب عبر GET /api/candidates/:id/voice-recording
# Account ID من لوحة Cloudflare → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# تعطيل التسجيل يدوياً حتى لو ضُبط R2 (افتراضي مفعّل): VOICE_RECORDING_ENABLED=false
# VOICE_RECORDING_ENABLED=true
# حدّ أقصى لحجم بايتات الصوت المتراكمة في الذاكرة لكل جلسة (افتراضي 60MB)
# VOICE_RECORDING_MAX_BYTES=62914560

# ============================================
# Video Interview (نفس المفاتيح أعلاه)
# ============================================
# LiveKit: بنك الأسئلة — الأولوية: jobId في body، ثم candidate.jobPostingId، ثم campaign.criteria.jobPostingId | jobId | job_id.
# يُمرَّر أيضاً position_slug لمحاولة ثانية في الوكيل. بدون تطابق: جلسة بدون بنك مخصص (ما لم تُفعّل INTERVIEW_QUESTIONS_USE_DEFAULT_FALLBACK على الوكيل).
# إن فعّلت true: يجب توفير ObjectId من أحد المصادر أعلاه (لا يكفي slug المنصب).
# VIDEO_INTERVIEW_REQUIRE_MONGO_JOB_ID=false
ELEVENLABS_VOICE_ID=21m00Tzpb8gXv3hC
BEYOND_PRESENCE_API_KEY=your_beyond_presence_key_here
BEYOND_PRESENCE_AVATAR_ID=your_avatar_id_here
BEYOND_PRESENCE_AUDIO_ENDPOINT=https://api.beyondpresence.ai/v1/audio
BEYOND_PRESENCE_EMBED_URL=https://beyondpresence.ai/embed
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================
# Voice Interview (WebSocket)
# ============================================
# اسم الشركة الافتراضي في ترحيب المقابلة (يُستخدم عند عدم وجود company_applied_to في بيانات المرشح)
# INTERVIEW_COMPANY_NAME=EVAALO
VOICE_WS_MAX_CONNECTIONS=200
VOICE_WS_MESSAGE_MAX_BYTES=65536
VOICE_WS_RATE_LIMIT_PER_MIN=60
VOICE_WS_PATH=/ws/voice-interview

# STT: مسار قديم ثقيل (LID + Deepgram + Speechmatics في وضع batch). الافتراضي معطّل.
# فعّل فقط إذا احتجت كشف اللغة لكل مقطع يدوياً: STT_ENABLE_BATCH_LID_ROUTING=1
# STT_ENABLE_BATCH_LID_ROUTING=1

# VAD — إعدادات كشف الصمت/الكلام (Deepgram، Speechmatics، مسار batch، عتبة RMS)
# VOICE_DEEPGRAM_ENDPOINTING_MS=800
# VOICE_BATCH_SILENCE_MS=1000
# VOICE_BATCH_SILENCE_AR_MS=1150
# VOICE_PCM_MIN_RMS=48
# VOICE_BATCH_ENERGY_RMS=175
# VOICE_VAD_CHECK_INTERVAL_MS=350
# VOICE_SPEECHMATICS_MAX_DELAY_SEC=0.85

# سرعة الشعور بالاستجابة (ms) — راجع docs/VOICE_AVATAR_OPTIMIZATION_STEPS.md
# VOICE_USER_STOPPED_MS=1300
# VOICE_USER_STOPPED_PUNCT_MS=1050
# VOICE_SPEECH_SILENCE_MS=1000
# VOICE_TTS_TO_STT_DELAY_MS=600
# VOICE_POST_AUDIO_PADDING_MS=250
# VOICE_PLAYBACK_ENDED_TIMEOUT_MS=30000
# VOICE_PLAYBACK_FALLBACK_MS=15000
# VOICE_POST_PLAYBACK_RESUME_MS=600
# تعطيل محاذاة الكلمات في TTS (أسرع): VOICE_TTS_USE_TIMESTAMPS=0

# ============================================
# LiveKit Configuration
# ============================================
# للحصول على API Keys: https://cloud.livekit.io
# أو تشغيل LiveKit Server محلياً — وثائق: https://docs.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
# If createRoom / dispatch fails with UND_ERR_CONNECT_TIMEOUT or "fetch failed":
# - Backend uses a longer global fetch connect timeout when LIVEKIT_URL is set (30s default).
# LIVEKIT_FETCH_CONNECT_TIMEOUT_MS=45000
# LIVEKIT_TWIRP_TIMEOUT_SEC=90
# LIVEKIT_HTTP_RETRIES=5
# LIVEKIT_HTTP_RETRY_BASE_MS=2000
# To use Node default connect timeout instead: LIVEKIT_FETCH_CONNECT_TIMEOUT_MS=0

# ============================================
# ============================================
# Webhook Idempotency (n8n inbound)
# ============================================
# يُوصى — في كل HTTP Request node ترسل لـ /webhook/n8n/stage1|2|3 أو
# /webhook/n8n/head-hunter ضع الرأس التالي:
#   X-Idempotency-Key: {{ $execution.id }}
#
# هذا يضمن dedupe دقيقاً 100% عند retries جزئية من n8n. بدون الرأس يُستخدم
# fallback: body.executionId ثم sha256(stable body). الـ ledger يخزن في
# Mongo collection: processed_webhooks (TTL 30 يوم).
#
# Clerk Authentication (Phase 1)
# Get both keys from: https://dashboard.clerk.com/ → API Keys
# Publishable key must match the frontend VITE_CLERK_PUBLISHABLE_KEY.
# ============================================
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...   (Phase 2 — Clerk Dashboard → Webhooks)
# RBAC_ENFORCEMENT=off           (set 'on' once roles are assigned in Clerk)
# ENFORCE_AUTH=off               (set 'on' once HR users can sign in via Clerk)
#
# Clerk Dashboard setup (required before ENFORCE_AUTH/RBAC_ENFORCEMENT=on):
#   1. JWT Templates → create "evaalo-backend" with claims:
#        userId, email, orgId, orgSlug, role, permissions
#   2. Organizations → create org + add HR users as members
#   3. User publicMetadata (per user):
#        { "role": "HR_MANAGER", "permissions": [] }
#      (empty permissions array = derive from role; use "OWNER" for full access)
#   4. Frontend VITE_CLERK_PUBLISHABLE_KEY must match CLERK_PUBLISHABLE_KEY above
#
# ============================================
# Stripe Billing (Phase 2b)
# Dashboard: https://dashboard.stripe.com/test/apikeys
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...   (required for in-page payment method modal)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_VIDEOPACK_TEAM=price_...
# STRIPE_PRICE_VIDEOPACK_PROFESSIONAL=price_...   (catalog display $20 — set Stripe Price to $20)
# STRIPE_PRICE_VIDEOPACK_BUSINESS=price_...         (catalog display $20 — set Stripe Price to $20)
# BILLING_DEV_TOOLS=true          (dev only: enable POST /api/billing/seed and /adjust)
# BILLING_LEGACY_PRICE_MAP={"price_1OldExample":{"planId":"business","cycle":"monthly"}}
# BILLING_ENFORCE=true            (set false to disable usage metering in dev)
# Local testing guide: docs/local-billing-testing.md
# Quick seed: BILLING_SEED_USER_ID=user_local_test BILLING_SEED_PLAN=team npx tsx src/scripts/seed-local-billing.ts
# USAGE_RESERVATION_TTL_MS=7200000  (active reservation TTL — default 2h)
# RECEPTION_BILLING_MODE=exempt   (voice reception: exempt | billable when org context exists)
# APP_PUBLIC_URL=http://localhost:3000
