# Windows: الافتراضي يستخدم Selector event loop لتقليل WinError 10054 عند قطع الاتصال.
# إذا احتجت Proactor الافتراضي: FORCE_PROACTOR_EVENT_LOOP=1

# LiveKit (مطلوب)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#
# --- مواءمة وثائق LiveKit (ملخص) ---
# الواجهة (frontend): adaptiveStream افتراضياً off للأفاتار الكبير؛ إن فعّلته استخدم pixelDensity=screen في الكود.
# dynacast افتراضياً off لمقابلة 1:1. الاتصال: أغلفة UDP/TURN/TLS على Cloud.
# راجع: apps/backend/LIVEKIT_SETUP.md قسم "مواءمة مع وثائق LiveKit"
#
# ICE للوكيل: الافتراضي all (مزيج host/srflx/relay) — غالباً أسرع من relay-only إن UDP للمنطقة جيد
# جدار ناري صارم / NAT: LIVEKIT_AGENT_ICE_MODE=relay أو LIVEKIT_AGENT_ICE_TRANSPORT=RELAY
# LIVEKIT_AGENT_ICE_MODE=all
# LIVEKIT_AGENT_ICE_MODE=relay
# LIVEKIT_AGENT_CONNECT_RETRIES=5
# ترافعي: LIVEKIT_AGENT_ICE_RELAY_DEFAULT=true يفرض relay إذا لم تضبط ICE_MODE
# WinError 10054: غالباً قطع WebSocket من شبكة/VPN/جدار — جرّب تعطيل VPN واستثناء التطبيق
# في Cloud LiveKit: فعّل TURN في المشروع (مطلوب لمسار relay)
#
# --- Cold start: avatar video gate (فهم لا متغيّر) ---
# Beyond Presence plugin يَستدعي DataStreamAudioOutput بـ wait_remote_track=KIND_VIDEO،
# أي أن أول بايت صوتي من TTS لا يُرسَل قبل أن يُنشر أول مسار فيديو من الـ avatar البعيد.
# ⇒ "أول كلمة" مرتبطة بزمن نشر الفيديو من Beyond، ولا يمكن إلغاؤها بمتغيّر بيئة.
# الحل المعتمد في المشروع: prewarm من الواجهة — POST /api/video-interview/prepare بمجرد توفّر
# candidateId (قبل الضغط على "ابدأ")، ليتم إنشاء الغرفة + dispatch الوكيل + بدء جلسة Beyond مبكراً،
# و /start يُعيد استخدام الجلسة عبر activeCandidateSessions (لا تكرار/لا غرفة ثانية).
# عطّله من الواجهة لو احتجت: VITE_DISABLE_VIDEO_PREPARE=1
#
# --- تحذير "10 seconds after job_entry" + wait_pc_connection timed out ---
# الرسالة room connection was not established within 10 seconds after calling job_entry تأتي من
# livekit-agents (عداد ثابت ~10 ث)؛ الوكيل يستدعي job_ctx.connect() في أول السطر. إذا اكتمل الاتصال
# بعدها (سترى job_ctx.connect finished in …s) فالتحذير معلوماتي وليس فشلاً.
# إن ظهر من Rust: wait_pc_connection timed out — جرّب LIVEKIT_AGENT_ICE_MODE=relay (أو RELAY)،
# تأكد من TURN في مشروع LiveKit Cloud، وقلّل VPN/جداراً صارماً؛ يمكن رفع إعادة المحاولة:
# LIVEKIT_AGENT_CONNECT_RETRIES=5

# مقاطعة كلام الوكيل: SDK يلغي الجيل القسرياً بعد 5s إن لم ينتهِ — ارفعها إن ظهرت "speech not done in time"
# LIVEKIT_SPEECH_INTERRUPTION_TIMEOUT=8
# انقطاع المستخدم (CLIENT_INITIATED) أثناء المقاطعة: فشل clear_buffer RPC / playback_finished تعسفي قد يظهر — طبيعي أثناء إغلاق الغرفة

# أسئلة المقابلة حسب job_id — يُحمّل الملف مرة واحدة؛ metadata تحمل job_id فقط (انظر backend videoInterview)
# الافتراضي: src/voice_interview/data/interview_questions.json (مفتاح jobs → { "job-id": ["Q1", ...], "__default__": [...] })
# مفاتيح موصى بها للإنتاج: MongoDB ObjectId لوثيقة الوظيفة/الإعلان (24 حرف hex)، يُمرَّر من الباكند كـ jobId في body.
# job overrides بالـ slug (مثل software-engineer، hr-specialist)؛ الـ aliases تُحلّ للـ canonical:
# software-developer → software-engineer و procurement-office → procurement-officer (موحّد مع الباكند).
# كل بنك (category/job) يحوي 10 أسئلة مرساة؛ الوكيل يختار ~3 منها. زِد INTERVIEW_QUESTIONS_MAX لعرض الكل.
# INTERVIEW_QUESTIONS_PATH=C:\path\to\interview_questions.json
# INTERVIEW_QUESTIONS_MAX=10
# INTERVIEW_QUESTION_MAX_CHARS=160
# اشتقاق مفتاح من حقل position عند غياب job_id (نفس منطق الـ slug في backend). عطّله في الإنتاج إن أجبرت دائماً jobId من الباكند:
# INTERVIEW_QUESTIONS_INFER_FROM_POSITION=true
# INTERVIEW_QUESTIONS_INFER_FROM_POSITION=false
# تراجع قديم: استخدام __default__ عند عدم تطابق أي مفتاح (الافتراضي عند الوكيل = false = start_no_bank)
# INTERVIEW_QUESTIONS_USE_DEFAULT_FALLBACK=false

# Hybrid interview heuristics (decision-engine framing بعد كل user turn)
# تشغّل ضمن on_user_turn_completed: تُحلّل جواب المرشح (طول/unsure/topic-change) وتحقن system message
# سياقي للـ LLM يقدّم 3 خيارات (probe / sub-aspect / move). راجع voice_interview/heuristics.py.
# عتبة الجواب القصير (أقل من هذا = shallow → يُقترح follow-up). تُقاس بعد التطبيع (مسح المسافات/التشكيل).
# HEURISTIC_SHALLOW_CHARS=30
# HEURISTIC_RICH_ANSWER_CHARS=80
# عدد follow-ups المسموحة لكل موضوع قبل تفعيل loop guard (افتراضي الكود 2 — يتماشى مع 3+2)
# HEURISTIC_MAX_FOLLOWUPS_PER_TOPIC=2
# بعد كم رد "ما أعرف"/"I don't know" متتالٍ يفرض الـ pivot لموضوع آخر بدل rephrase ثاني.
# HEURISTIC_UNSURE_PIVOT_THRESHOLD=2
# تعطيل الـ heuristics كلياً (الوكيل يصير reactive بحت — للتشخيص فقط).
# HEURISTIC_DISABLE=0
#
# QA بعد نشر وكيل المقابلة — راقب في اللوج:
#   decision_frame | ... memory=... action=...
#   session_summary | ... turns=... completion tokens via metrics_collected
# سيناريوهات يدوية: 3× «غير السؤال»، «شنو دخل»، إجابة غنية عن حقل، «عن نفسك»، تحقق عدم تكرار anchor.
# Entity policy (Phase A): راقب allowed_link_entities و recommended في decision_frame | link_policy=...

# Speechmatics STT — عربي/إنجليزي (ar_en) فقط؛ لا يوجد مسار Deepgram في الوكيل (مطلوب)
SPEECHMATICS_API_KEY=
# نقطة RT الأقرب لك تقلّل زمن الـ WebSocket وتقطع أقل (EU افتراضي المكتبة). راجع توثيق Speechmatics لمناطق RT.
# SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2
# مهلة WebSocket handshake (ثوانٍ) — عند timeout على الشبكة جرّب 45–90
# SPEECHMATICS_WS_OPEN_TIMEOUT_SEC=60
# جلسات طويلة / شبكة غير مستقرة: ارفع ping_timeout (ثوانٍ). ping_interval اختياري.
# SPEECHMATICS_WS_PING_TIMEOUT_SEC=120
# SPEECHMATICS_WS_PING_INTERVAL_SEC=20
# مواءمة LiveKit STT plugin: https://docs.livekit.io/agents/models/stt/plugins/speechmatics/
# نطاق تشغيل RT (اختياري) ورَبط النموذج — يقلل قطع الجلسة إن كنت بعيداً عن EU الافتراضي
# SPEECHMATICS_DOMAIN=
# صوت الدخول لـ RT: 16 kHz PCM افتراضي البلجن (متسق مع noise cancellation LiveKit)
# SPEECHMATICS_SAMPLE_RATE=16000
# SPEECHMATICS_CHUNK_SIZE=160
# مهلة STT في جلسة الوكيل (ثوانٍ) — ارفعها إذا ضغط الشبكة/الـ API
# SPEECHMATICS_HTTP_TIMEOUT=45
# output_locale: مع ar_en لا تستخدم ar (خطأ API). الافتراضي في الكود = ar فقط عند SPEECHMATICS_LANGUAGE=ar (أحادي).
# مع ar_en اترك غير مضبوط أو راجع توثيق Speechmatics لقيم مدعومة لتلك الحزمة.
# SPEECHMATICS_OUTPUT_LOCALE=ar
# مفردات إضافية لتحسين التعرف: JSON أو شكل مبسّط content|مرادف1|مرادف2;كلمة2|...
# SPEECHMATICS_EXTRA_VOCAB=[{"content":"اسم_الشركة","sounds_like":["اسم الشركه"]}]
# SPEECHMATICS_EXTRA_VOCAB=شركة إيفالو|ايفالو|إيفالو
#
# --- Bilingual code-switching (ar_en) ---
# عند ar_en نضيف تلقائياً ~56 كلمة HR/مقابلات إنجليزية شائعة (recruitment, manager,
# marketing, KPI, CV, leadership ...) لأن Speechmatics يميل للعربية إذا كان القاموس
# الإضافي عربياً بالكامل، فيُسقط الكلمات الإنجليزية المتقطعة من جملة عربية.
# عطّل لو أردت قاموس فارغ من الإنجليزية:
# SPEECHMATICS_DISABLE_EN_INTERVIEW_VOCAB=true
# مقابلات عربية فقط (بدون إنجليزي في النموذج): SPEECHMATICS_LANGUAGE=ar — جرّب إن كان الحديث عربي بالكامل
# حزمة STT ثابتة: يطبّق eou_silence و max_delay دون تعزيز المقابلة (الافتراضي في الكود: مفعّل)
# اكتشاف نهاية كلام: أعلى EOU/max_delay = نهائي أبطأ لكن جمل أتمّ (أقل ردود جزئية).
# بديل أسرع للـ STT: EOU_SILENCE≈0.5 و MAX_DELAY≈0.7 (قد يزيد القطع الجزئي).
SPEECHMATICS_INTERVIEW_FIXED_STT=true
# أسرع لظهور النص النهائي والوكيل: EOU أقصر (إن قُطعت الجملة ارفع تدريجياً 0.45–0.52)
SPEECHMATICS_EOU_SILENCE=0.40
# أقل من 0.7 يرفضه Speechmatics RT (transcription_config.max_delay) — الكود يرفع تلقائياً إن لزم
SPEECHMATICS_MAX_DELAY=0.70
# SPEECHMATICS_API_MIN_MAX_DELAY=0.7
# SPEECHMATICS_MAX_DELAY_EOU_GAP=0.08
# INTERVIEW_PROFILE=latency
# بث جزئي حقيقي من Speechmatics (partials) + إطار صوتي 160 عيّنة @16kHz ≈ 10ms
SPEECHMATICS_ENABLE_PARTIALS=true
SPEECHMATICS_CHUNK_SIZE=160

# OpenAI LLM (مطلوب)
OPENAI_API_KEY=
# أقل = ردود أقصر وأسرع (أفضل لزمن الأفاتار). الافتراضي في الكود 0.22
# OPENAI_TEMPERATURE=0.22
# حد لطول الرد (tokens) — الافتراضي في الكود 160 (~80 كلمة / 2-3 جمل). ارفع إلى 200+ لردود أطول، أو 128 لتقصير
# OPENAI_MAX_COMPLETION_TOKENS=160
# ضع 0 لتعطيل السقف (لا يُمرَّر max_completion_tokens)
# تعليمات الوكيل — الافتراضي في الكود: مقابلة فيديو احترافية (إنجليزي) + سؤال افتتاحي ثابت. استبدال كامل:
# INTERVIEW_AGENT_INSTRUCTIONS=...
# يُلحق بعد الافتراضي (مثلاً تذكير STT: المرشح يُسمَع عبر النسخ الفوري لا الشات فقط):
# INTERVIEW_AGENT_INSTRUCTIONS_EXTRA=
# أقل حروف prefetch = أول صوت أسرع لكن حدود مقاطع أكثر (تقطيع). مع INTERVIEW_PROFILE=latency الافتراضي في الكود ~17.
# لرد أسرع جداً: TTS_REPLY_PREFETCH_MAX_CHARS=14 وللأهدأ: 22–28
# TTS_REPLY_PREFETCH_MAX_CHARS=24

# ElevenLabs TTS (مطلوب)
ELEVENLABS_API_KEY=
# دعم الاسم القديم (اختياري للتوافق): ELEVEN_API_KEY
# صوت عربي - يجب أن يكون موجوداً في حساب ElevenLabs (خذه من elevenlabs.io/app/voice-library)
ELEVENLABS_VOICE_ID=pSfhiOqmR5ZWBE5pZErH
# اختياري: صوت إنجليزي منفصل. إذا لم تضبطه سيستخدم نفس الصوت العربي.
# ELEVENLABS_ENGLISH_VOICE_ID=
# موديل أسرع للأفاتار لتقليل slow audio generation
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# --- Streaming TTS (LiveKit + ElevenLabs WebSocket multi-stream) ---
# افتراضي: مفعّل — جملة بجملة (auto_mode) + أقل تأخير على مسار HTTP stream عند الحاجة
ELEVENLABS_TTS_STREAMING=true
# 0–4 لـ optimize_streaming_latency (مسار synthesize/HTTP). فارغ = 4. عطّل التمرير: off
# ELEVENLABS_STREAMING_LATENCY=4
# اختياري: 50–500 لكل قيمة، مفصولة بفاصلة (يُستخدم مع auto_mode=false بشكل أساسي)
# ELEVENLABS_CHUNK_LENGTH_SCHEDULE=120,160,250,290
# ELEVENLABS_AUTO_MODE=true
# مهم: لا تترك اللغة فارغة مع بعض إصدارات plugin — استخدم قيمة صريحة:
# ELEVENLABS_TTS_LANGUAGE=ar
# اختياري - إصلاح "connection closed" - زيادة timeout و inactivity
# ELEVENLABS_TTS_TIMEOUT=30
# ELEVENLABS_TTS_RETRY_INTERVAL=1.5
# ELEVENLABS_INACTIVITY_TIMEOUT=300
# Warm-up اختياري عند إقلاع الـ worker: GET /v1/voices لتسخين DNS/TLS/auth قبل أول جلسة
# (لا يولد صوتاً، لا تكلفة إضافية تذكر، يقلّل تأخير أول TTS عند الجلسة الأولى)
# ELEVENLABS_WARMUP_ON_WORKER_START=true
#
# --- جودة النطق العربي (ElevenLabs) ---
# الافتراضيات الجديدة (في الكود) ضُبطت للعربي:
#   stability=0.65 ، similarity=0.80 ، apply_text_normalization=off (يمنع تحريف الأرقام/الاختصارات).
# turbo سريع؛ لجودة أعلى وبطء: eleven_multilingual_v2 (بدون language override للموديلات غير turbo).
# لرفع وضوح الحروف الإطباقية (ض/ظ/ع/غ/ق) أكثر:
# ELEVENLABS_VOICE_STABILITY=0.70
# ELEVENLABS_VOICE_SIMILARITY=0.82
# اختياري: 0–1 ; سرعة 0.8–1.0 غالباً أنقى من 1.1 للعربية
# ELEVENLABS_VOICE_STYLE=0.0
# ELEVENLABS_VOICE_SPEED=0.95
# للرجوع إلى افتراضيات الإضافة (بدون voice_settings):
# ELEVENLABS_VOICE_NEUTRAL_DEFAULTS=true
# لمشاريع إنجليزية الغالبة: أعد التطبيع التلقائي:
# ELEVENLABS_APPLY_TEXT_NORMALIZATION=auto
# موديل أبطأ لكن غالباً أنقى للعربية (بدون language override لغير turbo):
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Beyond Presence أفاتار (مطلوب)
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_AVATAR_ID=
# BEYOND_PRESENCE_API_URL=  اختياري

# اختياري - استقرار الأفاتار (Beyond Presence) + STT
# --- LiveKit: سرعة الرد + انتشار أسرع للأفاتار + STT كامل الجملة (موازنة) ---
# ضع هذا السطر لتفعيل ملف الإعدادات الموصى به للـ latency (بدل ضبط عشرات المتغيرات يدوياً):
# https://docs.livekit.io/agents/logic/sessions/  (AgentSession: preemptive_generation, endpointing)
# --- LiveKit «ستريمنج حقيقي» (وثائق) ---
# نص + ترانسكريبت الوكيل: https://docs.livekit.io/agents/multimodality/text/
# بث النص بين المشاركين (lk.transcription): https://docs.livekit.io/transport/data/text-streams/
# جلسة الوكيل (preemptive_generation، endpointing): https://docs.livekit.io/agents/logic/sessions/
# LIVEKIT_SYNC_TRANSCRIPTION=false = نص أسرع للواجهة (افتراضي المشروع). true = مزامنة مع مسار الصوت
# LIVEKIT_TRANSCRIPTION_SPEED_FACTOR=1.0
# https://docs.livekit.io/agents/models/stt/plugins/speechmatics/  (max_delay, end_of_utterance_silence_trigger)
# وضع السرعة مفعّل افتراضياً (موصى به للمقابلات الحية + أفاتار): رد أسرع + preemptive + سقف endpointing أقل.
# للعودة للوضع الأهدأ بدّل القيمة إلى stability (دورات أوضح وأقل تقطيع، لكن تأخير دور أعلى).
INTERVIEW_PROFILE=latency
# INTERVIEW_PROFILE=stability
#
# --- لهجة المقابلة بالعربي ---
# msa         = فصحى نقية
# iraqi_light = فصحى + رشّة عراقية مهنية (موصى به للمقابلات؛ افتراضي الكود)
# iraqi       = لهجة عراقية كاملة (غير رسمي)
# ملاحظة: هذا الإعداد يغيّر الكلمات فقط، لا اللكنة الصوتية. للكنة عراقية حقيقية في الصوت
# تحتاج إلى استنساخ صوت من متحدث عراقي عبر ElevenLabs Voice Lab وضبط ELEVENLABS_VOICE_ID_AR.
# INTERVIEW_DIALECT=iraqi_light
# عند استخدام latency: تأكد AVATAR_STABILITY_MODE=false في .env.local إن كان مضبوطاً على true يدوياً
# AVATAR_STABILITY_MODE=false
# توصية: Speechmatics مسؤول وحيد عن نهاية الجملة (لا VAD)
# الافتراضات في الوكيل: enhanced، max_delay=1.0، eou_silence أعلى مع تعزيز المقابلة، + مفردات عراقية
# تعزيز المقابلة (افتراضي): يصحّح إعدادات ضعيفة من .env.local (standard/0.35/adaptive/...)
# SPEECHMATICS_INTERVIEW_DEFAULTS=true
# عطّل التعزيز لتستخدم القيم كما في الملف: SPEECHMATICS_INTERVIEW_DEFAULTS=false
# DISABLE_VAD=true
# SPEECHMATICS_LANGUAGE=ar_en
# SPEECHMATICS_OPERATING_POINT=enhanced
#
# --- Turn detector (LiveKit contextual end-of-turn model) ---
# https://docs.livekit.io/agents/logic/turns/turn-detector/
# يفهم نهاية الجملة سياقياً (لا يعتمد على الصمت فقط) فيقلّل قطع الجمل العربية
# الطويلة ويسمح بأخذ نَفَس داخل الجواب دون أن يردّ الوكيل قبل أن تنتهي.
#
# الافتراضي الإنتاجي الموصى به (ar/en/bilingual):  multilingual
# المتطلبات:
#   1) DISABLE_VAD=false  (النموذج يحتاج Silero VAD كمصدر صوتي)
#   2) تنزيل النماذج مرة واحدة قبل النشر:
#        uv run python -m livekit.agents.cli download-files
#
# القيم الصالحة (worker.py يطابقها بالترتيب):
#   multilingual  → MultilingualModel  (الافتراضي للإنتاج، ar+en)
#   english       → EnglishModel       (للنشر الإنجليزي فقط)
#   stt           → اعتماد STT EOU من Speechmatics (احتياطي قديم)
#   vad           → اعتماد Silero VAD وحده (أبسط، أقل ذكاء سياقياً)
#   فارغ/off      → نفس "vad" مع VAD مفعّل، أو "stt" إن كان VAD معطّلاً
#
# لا تعدّل هذا السطر للإنتاج — أزل التعليق فقط:
TURN_DETECTOR_MODEL=multilingual
#
# --- Metrics observability ---
# يطبع EOU/LLM/TTS/STT بشكل موجز + ملخص استخدام عند نهاية الجلسة.
# METRICS_OBSERVABILITY=true
# مستوى السجل: debug | info | warning | error (افتراضي info)
# METRICS_LOG_LEVEL=info
# SPEECHMATICS_MAX_DELAY=1.0
# SPEECHMATICS_EOU_SILENCE=0.75
# مع تعزيز المقابلة + ar_en: إن لم تضبط SPEECHMATICS_EOU_MODE يصبح fixed افتراضياً (أقل Fallback EOU من adaptive)
# SPEECHMATICS_EOU_MODE=adaptive
# SPEECHMATICS_AR_EN_DEFAULT_FIXED_EOU=true
# عند ضبط adaptive صراحةً، سيُجبر الوكيل fixed افتراضياً في ar_en (لتقليل fallback EOU)
# اجعلها true فقط إذا أردت adaptive فعلياً:
# SPEECHMATICS_AR_EN_ALLOW_ADAPTIVE=false
# SPEECHMATICS_INTERVIEW_FORCE_FIXED_EOU=false
# SPEECHMATICS_MAX_DELAY_EOU_GAP=0.12
# افتراضي false — رد أسرع + أقل تقطيع؛ ضع true لأرضية endpointing أعلى + clear_buffer أطول (أقل تفتيت STT)
# AVATAR_STABILITY_MODE=false
# مع STABILITY=true وحدة الأفاتار بطيئة: true يقصّر EOU/endpointing وفاصل مقاطع TTS (تجريبياً أسرع؛ قلّل SPEECHMATICS_INTERVIEW_TARGET_MAX_DELAY إن كان ~1.1)
# AVATAR_FAST_RESPONSE=true
# واجهة المقابلة (apps/frontend/.env*): تثبيت جودة فيديو الأفاتار بعد أول subscribe — أقل = ظهور أسرع (80–2000ms)
# VITE_AVATAR_SUBSCRIBE_QUALITY_MIN_INTERVAL_MS=200
# VITE_AVATAR_MIC_UNMUTE_DELAY_MS كبير جداً (>~900ms) يقطع بداية كلام المستخدم (الميكروفون لا يُرسل). جرّب 400–600ms
# مع turn_detection=stt: MIN يُضاف بعد إشارة نهاية الكلام من Speechmatics (إضافي على EOU) — ارفع ~0.4–0.5 لاكتشاف نهاية جملة أدق
# INTERVIEW_MIN_ENDPOINTING_FLOOR=0.22
# إن خفّضت MAX_ENDPOINTING_DELAY (~0.8) اضبط INTERVIEW_MAX_ENDPOINTING_CEILING=0.8 وإلا يُرفع تلقائياً إلى ~1.12
# INTERVIEW_MAX_ENDPOINTING_CEILING=0.8
# INTERVIEW_LATENCY_MAX_ENDPOINTING_CAP=0.85
# MIN_ENDPOINTING_DELAY=0.3
# MAX_ENDPOINTING_DELAY=0.8
# حد أدنى لطول كلام المستخدم لاعتباره مقاطعة (LiveKit default 0.5)
# MIN_INTERRUPTION_DURATION=0.52
# بعد مقاطعة محتملة، انتظر نص المستخدم (ثوانٍ) — none يعطّل
# FALSE_INTERRUPTION_TIMEOUT=2.5
# يفضّل false في الأفاتار لتجنب قطع الصوت أثناء حالات uninterruptible
# DISCARD_AUDIO_IF_UNINTERRUPTIBLE=false
# فاصل بين مقاطع TTS: أقل = أسرع حركة شفاه لكن قد يسمع تقطيع؛ مع AVATAR_FAST_RESPONSE افتراضي المقابلة ~0.11s
# MIN_CONSECUTIVE_SPEECH_DELAY=0.12
#timeouts HTTP لـ STT/LLM (ثوانٍ) — انظر أيضاً SPEECHMATICS_HTTP_TIMEOUT أعلى قرب إعدادات Speechmatics
# OPENAI_HTTP_TIMEOUT=30
# أدنى صمت لـ Speechmatics adaptive (أسرع رد أفاتار؛ ارفع 0.78–0.82 إذا زاد قطع الجمل)
# SPEECHMATICS_INTERVIEW_ADAPTIVE_SOFT_CAP=0.76
# توليد مبكر (مهم لحالة thinking): يبدأ مسار LLM/TTS قبل اكتمال نية المستخدم — أقل انتظار في الواجهة.
# PREEMPTIVE_GENERATION=false يُطيل thinking بشكل واضح؛ مع INTERVIEW_PROFILE=latency استخدم true.
# INTERVIEW_FORCE_PREEMPTIVE_GENERATION=true يفرض التفعيل حتى لو stability يعطّل الافتراضي
# PREEMPTIVE_GENERATION=true
# buffer بعد clear_buffer (Beyond / DataStream): قصير جداً (~2s SDK) يسبب تحذيرات
# الكود الافتراضي للمقابلة ~20s؛ أرضية ~18s (snappy) / ~20s (stability). رفع يدوي: 22–24 إن بقيت تحذيرات
# AVATAR_CLEAR_BUFFER_TIMEOUT=
# أرضية/سقف للمقابلة (يجب السقف >= الأرضية)
# AVATAR_CLEAR_BUFFER_MIN_INTERVIEW=18.0
# AVATAR_CLEAR_BUFFER_MAX_INTERVIEW=28.0
# قمع playback_finished الزائدة: مع SPEECHMATICS_INTERVIEW_DEFAULTS يُفعّل تلقائياً ما لم تضبط القيمة صراحةً
# PLAYBACK_PATCH_SUPPRESS_EXTRA_FINISHED=true
# لتعطيل الرقعة رغم المقابلة: PLAYBACK_PATCH_SUPPRESS_EXTRA_FINISHED=false
# أول بايت TTS أسرع (0–4؛4 أعدّل للـ HTTP path): إن كان عندك 2 جرّب 4
# ELEVENLABS_STREAMING_LATENCY=4
# ترحيب أولي بالوكيل (يستخدم metadata: الاسم، المنصب، …). عطّل: SKIP_INITIAL_GREETING=1
# SKIP_INITIAL_GREETING=0
# لغة الترحيب الأول: ar (افتراضي، عربي فقط) أو bilingual/auto/mixed أو en (إنجليزي فقط)
# INITIAL_GREETING_LANGUAGE=ar
# افتراضي الكود: ترحيب جاهز + TTS فقط (بدون LLM) = أسرع. للتنويع عبر OpenAI: INITIAL_GREETING_USE_LLM=true
# INITIAL_GREETING_USE_LLM=false
# تحية محايدة بدون تفضل/تفضلي — مثال: «حياك الله {name}، نبدأ من خبرتك العملية» (افتراضي true)
# INITIAL_GREETING_NEUTRAL_ADDRESS=true
# بلوك CANDIDATE GENDER في برومت الوكيل (تفضل/تفضلي) — افتراضي false بعد Phase A
# INTERVIEW_USE_GENDER_ADDRESS=false
# رد ثابت عند «عرفيني عن نفسك» / «من أنت؟» — TTS مباشر بدون LLM (افتراضي مدمج بالكود)
# INTERVIEW_IDENTITY_REPLY_AR=أنا مساعد مقابلات إيفالو، موجود هنا أسألك عن خبرتك بهالوظيفة. إذا جاهز، نكمل.
# INTERVIEW_IDENTITY_REPLY_EN=I'm Evaalo's interview assistant. I'm here to learn about your experience for this role. When you're ready, we can continue.
# QA Survey Engineer بعد النشر: «أنا جاهز» → لا Total Station؛ «GPS مو Total Station» → سؤال GPS فقط
# USER_COMMIT_COOLDOWN_MS=900
# مع تعزيز المقابلة: افتراضي 4 أحرف (قصيرة بالعربية/الإنجليزية)؛ زد إلى 6 لتقليل الشظايا
# MIN_USER_TRANSCRIPT_CHARS=4
# أدنى سقف للمقابلة فقط (2–12): اجعله 3 لـ "نعم"/"لا" إن كان الضجيج مقبولاً
# MIN_USER_TRANSCRIPT_CHARS_INTERVIEW_FLOOR=4
# MANUAL_COMMIT_USER_TURN=false
# مقاطعة أثناء كلام الوكيل — الافتراضي في الكود: مسموح (ALLOW_INTERRUPTION=true، INTERVIEW_HARD_NO_INTERRUPT=false)
# لمنع المقاطعة: INTERVIEW_HARD_NO_INTERRUPT=true و ALLOW_INTERRUPTION=false
# INTERVIEW_HARD_NO_INTERRUPT=false
# ALLOW_INTERRUPTION=true
# أهدأ للأفاتار بدل الحظر الكامل: ارفع MIN_INTERRUPTION_DURATION (~0.95–1.15)
# INTERVIEW_FORCE_ALLOW_INTERRUPTION=false
# حد أدنى لطول الجملة قبل تأكيد تبديل الصوت (5 يسمح بـ Hello/نعم)
# TTS_LANG_SWITCH_MIN_CHARS=5
# تطبيق فوري لصوت/لغة ElevenLabs عند كل جملة نهائية (موصى به لأفاتار متعدد اللغات). عطّل: TTS_LANG_SWITCH_IMMEDIATE=false
# TTS_LANG_SWITCH_IMMEDIATE=true
# TTS_LANG_SWITCH_CONFIRM_TURNS=1
# TTS_LANG_SWITCH_COOLDOWN_MS=4000
#
# --- Code-switching guard (Arabic with English loanwords) ---
# المرشح يقول "أنا عندي مهارة recruitment" — جملة عربية بكلمة لاتينية واحدة.
# نريد أن يبقى الصوت + الـ LLM بالعربي ولا يقطع الكلام عند الكلمة الإنجليزية.
# عدد الأدوار المتتالية المطلوبة لتأكيد تبديل ar -> en (en -> ar يبقى فورياً).
# 2 = آمن للمقابلات؛ 1 = أسرع تبديل؛ 3 = أكثر صرامة.
# TTS_LANG_SWITCH_AR_TO_EN_CONFIRM_TURNS=2
#
# --- Language detector tunables (lang.py) ---
# الحد الأدنى لنسبة الحروف العربية للحكم بأن الجملة عربية (loanwords مسموحة).
# ارفع لو كثيراً ما يُحكم على جمل لاتينية بحتة كعربية (نادر).
# LANG_DETECT_AR_SHARE_FLOOR=0.35
# الحد الأدنى لعدد الحروف اللاتينية للحكم بأن الجملة إنجليزية بحتة (لا حروف عربية أصلاً).
# ارفع إذا كلمات قصيرة مثل "ok / hello" تسبب تبديلاً غير مرغوب؛ خفّض إذا أدوار إنجليزية قصيرة لا تُكتشف.
# LANG_DETECT_EN_MIN_LATIN_CHARS=8
# سجل (ar, lat, decision) لكل استدعاء — للتشخيص فقط.
# LANG_DETECT_DEBUG=false
# مسار الأفاتار يستخدم DataStreamIO — لا يدعم pause؛ الافتراضي false يزيل تحذير SDK
# RESUME_FALSE_INTERRUPTION=false
# واجهة الويب: fallback WebSocket legacy معطل افتراضياً (LiveKit-only) لتحسين الاستقرار
# VITE_ENABLE_LEGACY_WS_FALLBACK=false
# مهلة فك ربط فيديو الأفاتار بعد unsubscribe اللحظي (ms) — ارفعها إذا ظهر تقطيع بعد الرد
# VITE_AVATAR_VIDEO_UNSUB_DEBOUNCE_MS=2200
